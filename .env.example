# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.

APP_ENV=development
DEBUG=true

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=invoice_app
POSTGRES_PASSWORD=change_me_in_dev
POSTGRES_DB=invoice_compliance_db

# --- PostgreSQL admin/bootstrap credentials (TEST INFRASTRUCTURE ONLY) ---
# Used only by tests/conftest.py to create/drop the disposable test
# database. The application itself never uses these. invoice_app
# deliberately does NOT have CREATEDB/SUPERUSER; this role does.
# Defaults to the standard 'postgres' superuser role present on any fresh
# PostgreSQL install (Windows installer, Linux package, or the official
# Docker image all create one). Set POSTGRES_ADMIN_PASSWORD to whatever you
# set for that role during installation.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_me_in_dev

# --- CORS (comma-will-not-work; edit config.py list default or extend via env parsing if needed) ---
# CORS_ORIGINS is currently defaulted in code to localhost dev servers.

# --- File storage ---
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=15

LOG_LEVEL=INFO

# --- GST Sandbox API (Phase 6B) ---
# Contract verified against developer.sandbox.co.in's published OpenAPI
# spec (Authenticate + Verify GSTIN). Uses a two-step key+secret -> JWT
# flow, so BOTH key and secret are required -- a single key is not enough.
# Leave unset to run without external GST verification (format-only checks
# still work; the system will never claim a GSTIN is active/registered
# without these being configured).
# TEST environment base URL per Sandbox's docs:
GST_SANDBOX_API_BASE_URL=https://test-api.sandbox.co.in
GST_SANDBOX_API_KEY=
GST_SANDBOX_API_SECRET=
GST_SANDBOX_API_VERSION=1.0.0
GST_SANDBOX_API_TIMEOUT_SECONDS=5.0
